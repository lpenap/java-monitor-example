<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.penapereira</groupId>
	<artifactId>java-threads-monitor-example</artifactId>
	<version>0.5.2</version>
	<name>java-threads-monitor-example</name>
	<description>Basic example of how to implement the monitor synchronization construct to allow mutual exclusion in threads</description>

        <properties>
                <java.version>25</java.version>
        </properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<exclusions>
				<!-- No test uses Mockito; excluding it avoids the dynamic agent warning. -->
				<exclusion>
					<groupId>org.mockito</groupId>
					<artifactId>mockito-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.mockito</groupId>
					<artifactId>mockito-junit-jupiter</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
               <plugins>
                       <plugin>
                               <groupId>org.springframework.boot</groupId>
                               <artifactId>spring-boot-maven-plugin</artifactId>
                       </plugin>
                       <plugin>
                               <groupId>org.jacoco</groupId>
                               <artifactId>jacoco-maven-plugin</artifactId>
                               <version>0.8.15</version>
                               <configuration>
                                       <excludes>
                                               <exclude>com/penapereira/example/javamonitor/ui/**</exclude>
                                               <exclude>com/penapereira/example/javamonitor/JavaThreadsMonitorExampleApplication*</exclude>
                                               <exclude>com/penapereira/example/javamonitor/Constants*</exclude>
                                       </excludes>
                               </configuration>
                               <executions>
                                       <execution>
                                               <goals>
                                                       <goal>prepare-agent</goal>
                                               </goals>
                                       </execution>
				       <execution>
                                               <id>generate-code-coverage-report</id>
                                               <phase>test</phase>
                                               <goals>
                                                       <goal>report</goal>
                                               </goals>
                                       </execution>
                                       <execution>
                                               <id>check-code-coverage</id>
                                               <phase>test</phase>
                                               <goals>
                                                       <goal>check</goal>
                                               </goals>
                                               <configuration>
                                                       <rules>
                                                               <rule>
                                                                       <element>BUNDLE</element>
                                                                       <limits>
                                                                               <limit>
                                                                                       <counter>INSTRUCTION</counter>
                                                                                       <value>COVEREDRATIO</value>
                                                                                       <minimum>0.95</minimum>
                                                                               </limit>
                                                                               <limit>
                                                                                       <counter>BRANCH</counter>
                                                                                       <value>COVEREDRATIO</value>
                                                                                       <minimum>0.90</minimum>
                                                                               </limit>
                                                                       </limits>
                                                               </rule>
                                                       </rules>
                                               </configuration>
                                       </execution>
                               </executions>
                       </plugin>
               </plugins>
       </build>

</project>
